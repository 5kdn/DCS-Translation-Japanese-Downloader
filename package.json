{
  "name": "dcs-translation-japanese-downloader",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "license": "MIT",
  "pnpm": {
    "patchedDependencies": {
      "@microsoft/kiota-abstractions@1.0.0-preview.100": "patches/@microsoft__kiota-abstractions@1.0.0-preview.100.patch"
    },
    "onlyBuiltDependencies": [
      "msw"
    ]
  },
  "scripts": {
    "dev": "vite --port 5177",
    "build": "pnpm run generate-licenses && vue-tsc -b && vite build",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e && pnpm run test:storybook",
    "test:unit": "vitest --run --project unit",
    "test:integration": "vitest --run --project integration",
    "test:e2e": "pnpm exec playwright install chromium && playwright test",
    "test:storybook": "pnpm exec playwright install chromium && vitest --run --project storybook",
    "lint": "biome lint .",
    "fmt": "biome format . --write",
    "check": "biome check .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate-apiClient": "kiota generate --openapi https://dcs-translation-japanese-cloudflare-worker.dcs-translation-japanese.workers.dev/openapi.json --language TypeScript --clean-output -o src/lib/http/apiClient",
    "update-apiClient": "kiota update -o src/lib/http/ --clean-output",
    "generate-licenses": "license-checker-rseidelsohn --json --production --excludePrivatePackages --out src/assets/LICENSES/licenses.json --customPath license-checker-rseidelsohn-customFormat.json --clarificationsFile license-checker-rseidelsohn-license-clarifications.json",
    "chromatic": "pnpx chromatic"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@microsoft/kiota-abstractions": "1.0.0-preview.100",
    "@microsoft/kiota-http-fetchlibrary": "1.0.0-preview.100",
    "@microsoft/kiota-serialization-form": "1.0.0-preview.100",
    "@microsoft/kiota-serialization-json": "1.0.0-preview.100",
    "@microsoft/kiota-serialization-multipart": "1.0.0-preview.100",
    "@microsoft/kiota-serialization-text": "1.0.0-preview.100",
    "dompurify": "^3.4.5",
    "jszip": "^3.10.1",
    "markdown-it": "^14.1.1",
    "markdown-it-task-lists": "^2.1.1",
    "vue": "^3.5.34",
    "vuetify": "^4.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@chromatic-com/storybook": "^5.2.1",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/addon-vitest": "^10.4.2",
    "@storybook/vue3": "^10.4.2",
    "@storybook/vue3-vite": "^10.4.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/browser": "4.1.8",
    "@vitest/browser-playwright": "4.1.8",
    "@vue/language-plugin-pug": "^3.3.4",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "msw": "^2.14.6",
    "msw-storybook-addon": "^2.0.7",
    "playwright": "^1.60.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.100.0",
    "storybook": "^10.4.2",
    "terser": "^5.48.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.4"
  }
}
