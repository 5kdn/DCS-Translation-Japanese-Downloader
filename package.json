{
  "name": "dcs-translation-japanese-downloader",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "msw"
    ]
  },
  "scripts": {
    "dev": "vite --port 5177",
    "build": "pnpm run generate-licenses && pnpm run typecheck && vite build",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e && pnpm run test:storybook",
    "test:unit": "vitest --run --project unit",
    "test:integration": "vitest --run --project integration",
    "test:e2e": "pnpm exec playwright install chromium && playwright test",
    "test:storybook": "pnpm exec playwright install chromium && vitest --run --project storybook",
    "typecheck": "vue-tsc -b",
    "lint": "biome lint .",
    "fmt": "biome format . --write",
    "check": "biome check .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "restore-tools": "dotnet tool restore",
    "update-kiota": "dotnet tool update Microsoft.OpenApi.Kiota --local && pnpm run update-apiClient",
    "generate-apiClient": "pnpm run restore-tools && dotnet tool run kiota generate --openapi https://dcs-translation-japanese-cloudflare-worker.dcs-translation-japanese.workers.dev/openapi.json --language TypeScript --clean-output -o src/lib/http/apiClient && pnpm run typecheck",
    "update-apiClient": "pnpm run restore-tools && dotnet tool run kiota update -o src/lib/http/ --clean-output && pnpm run typecheck",
    "generate-licenses": "license-checker-rseidelsohn --json --production --excludePrivatePackages --out src/assets/LICENSES/licenses.json --customPath license-checker-rseidelsohn-customFormat.json --clarificationsFile license-checker-rseidelsohn-license-clarifications.json",
    "chromatic": "pnpx chromatic"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@microsoft/kiota-abstractions": "1.0.0-preview.103",
    "@microsoft/kiota-http-fetchlibrary": "1.0.0-preview.103",
    "@microsoft/kiota-serialization-form": "1.0.0-preview.103",
    "@microsoft/kiota-serialization-json": "1.0.0-preview.103",
    "@microsoft/kiota-serialization-multipart": "1.0.0-preview.103",
    "@microsoft/kiota-serialization-text": "1.0.0-preview.103",
    "dompurify": "^3.4.17",
    "jszip": "^3.10.1",
    "markdown-it": "^15.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "vue": "^3.5.40",
    "vuetify": "^4.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@chromatic-com/storybook": "^5.6.0",
    "@opentelemetry/api": "^1.10.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/vue3": "^10.6.3",
    "@storybook/vue3-vite": "^10.6.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vue/language-plugin-pug": "^3.3.13",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "license-checker-rseidelsohn": "^5.0.1",
    "msw": "^3.0.3",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.106.1",
    "storybook": "^10.6.3",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
